---
const socialLinks = [
  {
    title: "LinkedIn",
    subtitle: "Profile",
    url: "https://www.linkedin.com/in/arvidlangsoe/",
    icon: "/social-logos/linkedin-64.png"
  },
  {
    title: "GitHub",
    subtitle: "Profile",
    url: "https://github.com/kappelhoj",
    icon: "/social-logos/GitHub-Mark-Light-64px.png"
  }
];
---

<footer class="footer-wrapper">
  <div class="footer-content">
    <div class="social-links">
      {socialLinks.map((link) => (
        <a href={link.url} target="_blank" rel="noopener noreferrer" class="social-link">
          <img src={link.icon} alt={`${link.title} icon`} class="social-icon" />
          <div class="social-text">
            <span class="social-title">{link.title}</span>
            <span class="social-subtitle">{link.subtitle}</span>
          </div>
        </a>
      ))}
    </div>
    <div class="copyright">
      &copy; {new Date().getFullYear()} Arvid Kappelh&oslash;j
    </div>
  </div>
</footer>

<style>
  .footer-wrapper {
    background: var(--main-dark-color);
    color: var(--main-white-color);
    margin-top: auto;
    width: 100%;
  }

  .footer-content {
    max-width: 1280px;
    margin: 0 auto;
    padding: 1.5rem 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .social-links {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .social-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--main-white-color);
    text-decoration: none;
    padding: 0.4rem 0.6rem;
    border-radius: 6px;
    transition: background-color 0.2s ease, opacity 0.2s ease;
  }

  .social-link:hover {
    background: rgba(255, 255, 255, 0.1);
    opacity: 0.95;
    color: var(--main-white-color);
  }

  .social-icon {
    width: 2rem;
    height: 2rem;
    object-fit: contain;
  }

  .social-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .social-title {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .social-subtitle {
    font-size: 0.8rem;
    opacity: 0.75;
  }

  .copyright {
    font-size: 0.85rem;
    opacity: 0.75;
  }
</style>
