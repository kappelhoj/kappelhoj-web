---
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/\/$/, ""); // remove trailing slash

const navItems = [
  { title: "Home", path: "/" },
  { title: "Dev", path: "/dev" },
];
---

<header class="header">
  <div class="logo-area">
    <a href="/" class="brand-title">Kappelhoj</a>
  </div>
  <nav class="nav-bar">
    {navItems.map((item) => {
      const isActive = item.path === "/" ? currentPath === "" : currentPath === item.path;
      return (
        <a 
          href={item.path} 
          class:list={["nav-item", { active: isActive }]}
        >
          {item.title}
        </a>
      );
    })}
  </nav>
</header>

<style>
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 0;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border-color);
  }

  .brand-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--main-dark-color);
    letter-spacing: -0.02em;
  }

  .nav-bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-item {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--secondary-dark-color);
    padding: 0.25rem 0;
    position: relative;
  }

  .nav-item:hover {
    color: var(--main-dark-color);
  }

  .nav-item.active {
    color: var(--main-dark-color);
  }

  .nav-item.active::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--main-dark-color);
    border-radius: 2px;
  }
</style>
